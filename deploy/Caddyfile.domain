# Player entry once you own a domain: replace play.example.com. Caddy gets and renews the certificate itself (ports 80 and 443
# must be open). The page, its resources, the login service and the game WebSocket all share this one https origin, so the
# client needs no ws_url setting: an https page connects to wss://<this host>/ws.
play.example.com {
	encode gzip

	handle_path /loginapi/* {
		reverse_proxy 127.0.0.1:8081
	}

	handle /ws {
		reverse_proxy 127.0.0.1:8802
	}

	handle_path /cdn/* {
		root * /opt/2dround/cdn
		header Access-Control-Allow-Origin *
		@hashed path /f/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@manifest not path /f/*
		header @manifest Cache-Control "no-cache"
		file_server
	}

	handle {
		root * /opt/2dround/h5
		header Cache-Control "no-cache"
		file_server
	}
}
