# runtime data: database, backups, logs
/data/

# LAN config holds a private jwt_secret and this machine's address; copy configs/lan.example.yaml
/configs/lan.yaml

# Local capture coordination contains device/chat identifiers and live state.
/docs/CAPTURE_ANALYSIS_HANDOFF.md
/docs/CAPTURE_ANALYSIS_STATE.json
/docs/DAILY_CAPTURE_HANDOFF.md
/docs/DAILY_CAPTURE_WATCHDOG.json

# device screenshots (large, not code)
*.png

# Source artwork required to build and run the standalone summon demo.
!/demos/card-summon/assets/zoro-card-art.png
!/demos/card-summon/assets/zoro-pack-art-hd.png
!/demos/card-summon/assets/zoro-reference.png

# build output / editor files
*.exe
*.test
.DS_Store

# Vendored Geeker-Admin source assets (runtime screenshots above stay ignored)
!/web/admin/src/assets/**/*.png
!/web/admin/public/*.png

# Generated production UI snapshot is tracked so a clean Go checkout builds.
!/internal/admin/ui/assets/*.png
/internal/admin/ui.staging/
/bin/

# server deployment: the real config holds a private jwt_secret; build output of deploy/build.sh
/configs/prod.yaml
/deploy/out/
/deploy/*.tar.gz
/deploy/server.local
