# runtime data: database, backups, logs
/data/

# LAN config holds a private jwt_secret and this machine's address; copy configs/lan.example.yaml
/configs/lan.yaml

# device screenshots (large, not code)
*.png

# build output / editor files
*.exe
*.test
.DS_Store

# Vendored Geeker-Admin source assets (runtime screenshots above stay ignored)
!/web/admin/src/assets/**/*.png
!/web/admin/public/*.png

# Generated production UI snapshot is tracked so a clean Go checkout builds.
!/internal/admin/ui/assets/*.png
/internal/admin/ui.staging/
/bin/
